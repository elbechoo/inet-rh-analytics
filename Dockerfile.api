# Backend image (FastAPI). Postgres-focused (the chosen Phase 2 database).
# psycopg[binary] ships prebuilt, so no compiler is needed. unixodbc is included
# only so `import pyodbc` never fails if you keep DB_ENGINE=mssql; the SQL Server
# ODBC driver itself is NOT installed here (add microsoft's msodbcsql if needed).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends unixodbc curl \
    && rm -rf /var/lib/apt/lists/*

# Runtime dependencies only — requirements.txt also carries Streamlit and its
# dashboard stack, which the API never imports and which triples build time.
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY . .

EXPOSE 8000

# Run DB migrations, then start the API.
#
# This used to end the migration step with `|| true`, so the container would
# boot before the first migration existed. The cost of that convenience: a
# failed or absent migration looked exactly like a successful one. Combined
# with create_all(), which adds missing tables but never alters existing ones,
# the deployed schema drifted behind the ORM models for months without a single
# error - a column added to the models simply never reached the database, and
# nothing noticed until dbt introspected the real column list.
#
# Now a failed migration stops the container. A database the API cannot
# correctly serve should be loud, not silently half-migrated.
CMD ["sh", "-c", "alembic upgrade head && uvicorn api.main:app --host 0.0.0.0 --port 8000"]
