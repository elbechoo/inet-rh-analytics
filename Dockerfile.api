# Backend image (FastAPI). Postgres-focused (the chosen Phase 2 database).
# psycopg[binary] ships prebuilt, so no compiler is needed. unixodbc is included
# only so `import pyodbc` never fails if you keep DB_ENGINE=mssql; the SQL Server
# ODBC driver itself is NOT installed here (add microsoft's msodbcsql if needed).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends unixodbc curl \
    && rm -rf /var/lib/apt/lists/*

# Runtime dependencies only — requirements.txt also carries Streamlit and its
# dashboard stack, which the API never imports and which triples build time.
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY . .

EXPOSE 8000

# Run DB migrations (if any) then start the API. `|| true` keeps the container
# starting even before the first migration exists; the app also create_all()s
# the ORM tables on startup.
CMD ["sh", "-c", "alembic upgrade head || true; uvicorn api.main:app --host 0.0.0.0 --port 8000"]
