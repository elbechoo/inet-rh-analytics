# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control. NEVER paste real secrets in this example.

# JWT signing key — REQUIRED. The app refuses to start without it.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=__GENERATE_A_RANDOM_64_CHAR_STRING__

# Auth cookie: set to true when serving over HTTPS (production); false for local http dev.
COOKIE_SECURE=false

# Force-redirect all http requests to https. Enable in production once TLS is
# terminated by your reverse proxy / load balancer. Leave false for local dev.
FORCE_HTTPS=false

# Gmail credentials for email notifications (use a Gmail App Password, not your login).
GMAIL_USER=__YOUR_EMAIL__
GMAIL_PASSWORD=__YOUR_GMAIL_APP_PASSWORD__
RH_EMAIL=__HR_EMAIL__

# Frontend — backend URL (defaults to http://127.0.0.1:8000 if not set)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ── Database (Phase 2 — env-driven) ──────────────────────────────
# DB_ENGINE selects the backend:
#   mssql     (default) → SQL Server. With DB_USER/DB_PASSWORD blank it uses
#                          Windows Authentication (your current local setup).
#   postgres            → PostgreSQL (recommended for Docker / cloud / SaaS).
DB_ENGINE=postgres
DB_SERVER=db
DB_PORT=5432
DB_DATABASE=gestionrh
DB_USER=__DB_USER__
DB_PASSWORD=__SET_A_STRONG_PASSWORD__
# SQL Server ODBC driver name (only used when DB_ENGINE=mssql)
# DB_DRIVER=ODBC Driver 17 for SQL Server

# ── Docker reverse proxy ─────────────────────────────────────────
# Your domain in production (Caddy fetches a real cert automatically).
# Leave as localhost for local testing (uses Caddy's local CA).
SITE_ADDRESS=localhost
